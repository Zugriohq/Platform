<Project Sdk="Microsoft.NET.Sdk">
  <!-- Zugrio Market Lab: read-only research cBot. It places no orders (enforced by NoOrderApiOutsideEaExecution). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AlgoPublish>False</AlgoPublish>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Zugrio.CBot.Core/Zugrio.CBot.Core.csproj" />
  </ItemGroup>
</Project>
