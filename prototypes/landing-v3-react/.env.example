# Existing Zugrio Cloudflare naming
TURNSTILE_SITE_KEY=""

# Secret. Never expose through Vite/client variables.
TURNSTILE_SECRET=""

# Comma-separated hostnames accepted from Siteverify.
# Intended production values include zugrio.xyz and optionally www.zugrio.xyz.
TURNSTILE_HOSTNAMES="zugrio.xyz,www.zugrio.xyz"

PRIVACY_CONTACT="privacy@zugrio.xyz"
