# DB host (zugrio-alpha-micro-db). Copy to .env (chmod 600). Never commit the real file.
# Values below are placeholders, not credentials.

POSTGRES_DB=zugrio
POSTGRES_USER=zugrio
# Generate ONCE with: openssl rand -hex 32. The API host .env must carry the same value.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# This VM's PRIVATE VCN address (OCI console > instance > Networking), e.g. 10.42.1.x.
# Never 0.0.0.0 and never the public IP.
ZUGRIO_DB_BIND_ADDR=replace-with-db-vm-private-ip

# pg_dump target used by ./backup-postgres.sh.
ZUGRIO_BACKUP_DIR=/srv/zugrio/backups
