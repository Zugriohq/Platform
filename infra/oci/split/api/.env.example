# API host (zugrio-alpha-micro-api). Copy to .env (chmod 600). Never commit the real file.
# Values below are placeholders, not credentials.

POSTGRES_DB=zugrio
POSTGRES_USER=zugrio
# Must equal POSTGRES_PASSWORD in the DB host .env (hex keeps DATABASE_URL URL-safe).
POSTGRES_PASSWORD=replace-with-the-db-host-value
# The DB VM's PRIVATE VCN address, e.g. 10.42.1.x. Never its public IP.
ZUGRIO_DB_HOST=replace-with-db-vm-private-ip

ZUGRIO_API_IMAGE=zugrio-api:local
ZUGRIO_API_LOCAL_PORT=3000
ZUGRIO_CORS_ORIGINS=*

# Cloudflare Tunnel (only with ../../docker-compose.tunnel.yml). Secret: copy from
# Zero Trust > Networks > Tunnels > zugrio-alpha-api > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.9.3
