# Copy to infra/oci/.env on the VM (chmod 600). Never commit the real file.
# Values below are placeholders, not credentials.

# PostgreSQL (private alpha). Generate with: openssl rand -hex 32
# Hex keeps the password URL-safe inside DATABASE_URL.
POSTGRES_DB=zugrio
POSTGRES_USER=zugrio
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# API image. Leave as zugrio-api:local to build on the VM, or pin a registry digest.
ZUGRIO_API_IMAGE=zugrio-api:local
# Loopback-only host port for on-VM health checks (never exposed publicly).
ZUGRIO_API_LOCAL_PORT=3000
# Comma-separated CORS allow-list, or * (the alpha API carries no credentials).
ZUGRIO_CORS_ORIGINS=*

# Cloudflare Tunnel (only with docker-compose.tunnel.yml). Secret: copy from
# Zero Trust > Networks > Tunnels > zugrio-alpha-api > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.9.3

# Host directory for pg_dump backups written by infra/oci/backup-postgres.sh.
ZUGRIO_BACKUP_DIR=/srv/zugrio/backups
